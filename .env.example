# Model API (defaults are DeepSeek chat-completions compatible)
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Walrus Memory / MemWal credentials (required by the notebook server)
WALRUS_DELEGATE_KEY=your-memwal-delegate-key
WALRUS_ACCOUNT_ID=your-memwal-account-id
# MEMWAL_ENV=prod

# Telegram is optional. Needed only to run memoranda_bot.py.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# FIELDPACK_BASE=http://127.0.0.1:8770

# Optional notebook server bind settings (defaults: 127.0.0.1 and 8770)
# FIELDPACK_HOST=127.0.0.1
# FIELDPACK_PORT=8770

# Optional MemWal write timing overrides
# FIELDPACK_LAND_DEADLINE=10
# FIELDPACK_ABANDON_COOLDOWN=60

# Optional: read credentials from a file other than this project's .env
# MEMORANDA_ENV=/absolute/path/to/another.env

# Optional: which Telegram chat is told when the public tunnel link changes
# MEMORANDA_OWNER_CHAT=123456789
